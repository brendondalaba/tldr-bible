---
import { getCollection } from "astro:content";
import AccountMenu from "@/components/AccountMenu.astro";
import GenreBadge from "@/components/GenreBadge.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import TimesRead from "@/components/TimesRead.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// File names start with the book number (01-genesis ... 66-revelation).
const books = (await getCollection("bible")).sort((a, b) =>
  a.id.localeCompare(b.id)
);

const testaments = [
  { name: "Old Testament", books: books.slice(0, 39) },
  { name: "New Testament", books: books.slice(39) },
];
---

<BaseLayout
  title="Bible Sidekick - Bible Reading Tracker"
  description="Track your Bible reading chapter by chapter, with a quick breakdown of every book."
  showNav={false}
>
  <header class="border-b bg-surface">
    <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-16">
      <div class="flex items-start justify-between gap-4">
        <h1 class="font-semibold text-3xl tracking-tight sm:text-5xl">
          Bible Sidekick
        </h1>
        <div class="flex shrink-0 items-center gap-2">
          <ThemeToggle />
          <AccountMenu />
        </div>
      </div>
      <p class="mt-2 max-w-prose text-muted-foreground sm:mt-4 sm:text-lg">
        Track your reading chapter by chapter, with a quick breakdown of every
        book of the Bible
      </p>
      <a
        href="/start-here"
        class="mt-6 inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 font-medium text-primary-foreground transition-colors duration-150 hover:bg-primary/90"
      >
        New to the Bible? Start here
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </header>

  <div class="mx-auto w-full max-w-5xl space-y-10 px-4 py-8 sm:space-y-16 sm:px-6 sm:py-16">
    {
      
      testaments.map(testament => (
        <section>
          <h2 class="mb-4 font-semibold text-xl sm:mb-6 sm:text-2xl">{testament.name}</h2>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
            {testament.books.map(book => (
              <a
                href={`/bible/${book.id}`}
                class="block rounded-lg border bg-surface px-4 py-3 transition-colors duration-150 hover:border-primary sm:p-5"
              >
                <div class="flex items-center justify-between gap-3 sm:mb-2 sm:items-start">
                  <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
                    <h3 class="font-medium sm:text-lg">{book.data.title}</h3>
                    <TimesRead book={book.id} />
                  </div>
                  <GenreBadge genre={book.data.genre} class="shrink-0" />
                </div>
                <p class="line-clamp-1 text-muted-foreground text-sm sm:line-clamp-2">
                  {book.data.description}
                </p>
                <div
                  class="mt-2 hidden items-center gap-3"
                  data-card-progress={book.id}
                  data-chapters={book.data.chapters}
                >
                  <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-primary" data-card-fill />
                  </div>
                  <span
                    class="text-muted-foreground text-xs tabular-nums"
                    data-card-count
                  />
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  import { getProgressStore } from "@/lib/progress";

  // Show "12 / 50" and a bar on each book with a read-through in progress.
  const store = getProgressStore();

  function render() {
    for (const row of document.querySelectorAll<HTMLElement>(
      "[data-card-progress]"
    )) {
      const total = Number(row.dataset.chapters);
      const read = Object.keys(
        store.getBook(row.dataset.cardProgress ?? "").current
      ).length;
      row.classList.toggle("hidden", read === 0);
      row.classList.toggle("flex", read > 0);
      const fill = row.querySelector<HTMLElement>("[data-card-fill]");
      if (fill) fill.style.width = `${(read / total) * 100}%`;
      const count = row.querySelector("[data-card-count]");
      if (count) count.textContent = `${read} / ${total}`;
    }
  }

  store.subscribe(render);
  render();
</script>
