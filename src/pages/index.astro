---
import { getCollection } from "astro:content";
import GenreBadge from "@/components/GenreBadge.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// File names start with the book number (01-genesis ... 66-revelation).
const books = (await getCollection("bible")).sort((a, b) =>
  a.id.localeCompare(b.id)
);

const testaments = [
  { name: "Old Testament", books: books.slice(0, 39) },
  { name: "New Testament", books: books.slice(39) },
];
---

<BaseLayout
  title="Bible Sidekick - Quick Bible Summaries"
  description="Concise breakdowns of every book of the Bible"
>
  <header class="border-b bg-surface">
    <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 sm:py-16">
      <h1 class="font-semibold text-3xl tracking-tight sm:text-5xl">
        Bible Sidekick
      </h1>
      <p class="mt-2 max-w-prose text-muted-foreground sm:mt-4 sm:text-lg">
        Concise breakdowns of every book of the Bible
      </p>
      <a
        href="/start-here"
        class="mt-6 inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 font-medium text-primary-foreground transition-colors duration-150 hover:bg-primary/90"
      >
        New to the Bible? Start here
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </header>

  <div class="mx-auto w-full max-w-5xl space-y-10 px-4 py-8 sm:space-y-16 sm:px-6 sm:py-16">
    {
      
      testaments.map(testament => (
        <section>
          <h2 class="mb-4 font-semibold text-xl sm:mb-6 sm:text-2xl">{testament.name}</h2>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
            {testament.books.map(book => (
              <a
                href={`/bible/${book.id}`}
                class="block rounded-lg border bg-surface px-4 py-3 transition-colors duration-150 hover:border-primary sm:p-5"
              >
                <div class="flex items-center justify-between gap-3 sm:mb-2 sm:items-start">
                  <h3 class="font-medium sm:text-lg">{book.data.title}</h3>
                  <GenreBadge genre={book.data.genre} class="shrink-0" />
                </div>
                <p class="line-clamp-1 text-muted-foreground text-sm sm:line-clamp-2">
                  {book.data.description}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
