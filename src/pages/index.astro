---
import { getCollection } from "astro:content";
import GenreBadge from "@/components/GenreBadge.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// File names start with the book number (01-genesis ... 66-revelation).
const books = (await getCollection("bible")).sort((a, b) =>
  a.id.localeCompare(b.id)
);

const testaments = [
  { name: "Old Testament", books: books.slice(0, 39) },
  { name: "New Testament", books: books.slice(39) },
];
---

<BaseLayout
  title="TLDR Bible - Quick Bible Summaries"
  description="Concise breakdowns of every book of the Bible"
>
  <header class="border-b bg-surface">
    <div class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
      <h1 class="font-semibold text-4xl tracking-tight sm:text-5xl">
        TLDR Bible
      </h1>
      <p class="mt-4 max-w-prose text-lg text-muted-foreground leading-8">
        Concise breakdowns of every book of the Bible
      </p>
      <a
        href="/start-here"
        class="mt-8 inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 font-medium text-primary-foreground transition-colors duration-150 hover:bg-primary/90"
      >
        New to the Bible? Start here
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </header>

  <div class="mx-auto w-full max-w-5xl space-y-16 px-4 py-16 sm:px-6">
    {
      testaments.map(testament => (
        <section>
          <h2 class="mb-6 font-semibold text-2xl">{testament.name}</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {testament.books.map(book => (
              <a
                href={`/bible/${book.id}`}
                class="block rounded-lg border bg-surface p-5 transition-colors duration-150 hover:border-primary"
              >
                <div class="mb-2 flex items-start justify-between gap-3">
                  <h3 class="font-medium text-lg">{book.data.title}</h3>
                  <GenreBadge genre={book.data.genre} class="shrink-0" />
                </div>
                <p class="line-clamp-2 text-muted-foreground text-sm">
                  {book.data.description}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
