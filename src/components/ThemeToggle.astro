<!--
  Cycles System → Light → Dark. Each mode has its own icon; phones show the icon
  only, larger screens add the label. The button's aria-label always says the
  current mode and what tapping does next.
-->
<button
  type="button"
  data-theme-toggle
  data-mode="system"
  class="group inline-flex h-9 min-w-9 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-input px-2 text-sm transition-colors duration-150 hover:bg-accent hover:text-accent-foreground sm:px-3"
>
  <svg
    class="size-4 shrink-0 group-data-[mode=light]:hidden group-data-[mode=dark]:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M8 20h8M12 16v4"></path>
  </svg>
  <svg
    class="hidden size-4 shrink-0 group-data-[mode=light]:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="hidden size-4 shrink-0 group-data-[mode=dark]:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <span class="hidden sm:inline" data-theme-label>System theme</span>
</button>

<script>
  import { applyThemeColor } from "@/lib/themeColor";

  type Theme = "system" | "light" | "dark";

  const NEXT: Record<Theme, Theme> = {
    system: "light",
    light: "dark",
    dark: "system",
  };

  const LABEL: Record<Theme, string> = {
    system: "System theme",
    light: "Light theme",
    dark: "Dark theme",
  };

  const root = document.documentElement;

  function getTheme(): Theme {
    const theme = root.dataset.theme;
    return theme === "light" || theme === "dark" ? theme : "system";
  }

  function setTheme(theme: Theme) {
    if (theme === "system") delete root.dataset.theme;
    else root.dataset.theme = theme;
    applyThemeColor(theme);

    try {
      if (theme === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", theme);
    } catch {
      // Storage can be blocked (private mode); the theme still applies for this visit.
    }
  }

  function render(theme: Theme) {
    for (const button of document.querySelectorAll<HTMLElement>(
      "[data-theme-toggle]"
    )) {
      button.dataset.mode = theme;
      button.title = LABEL[theme];
      button.setAttribute(
        "aria-label",
        `${LABEL[theme]}. Switch to ${LABEL[NEXT[theme]].toLowerCase()}.`
      );
      const label = button.querySelector("[data-theme-label]");
      if (label) label.textContent = LABEL[theme];
    }
  }

  render(getTheme());

  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = NEXT[getTheme()];
      setTheme(next);
      render(next);
    });
  }
</script>
