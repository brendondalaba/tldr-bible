<!--
  Link to /account: a person icon when signed out (opens sign-up), the reader's
  initial when signed in (opens their account). Hidden if the site was built
  without Supabase settings.
-->
<a
  href="/account"
  data-account
  aria-label="Sign up or sign in"
  title="Sign up or sign in"
  class="group hidden h-9 min-w-9 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-input px-2 text-sm transition-colors duration-150 hover:bg-accent hover:text-accent-foreground data-[signed-in]:rounded-full data-[signed-in]:border-primary data-[signed-in]:bg-primary data-[signed-in]:px-0 data-[signed-in]:font-semibold data-[signed-in]:text-primary-foreground sm:px-3"
>
  <svg
    class="size-4 shrink-0 group-data-[signed-in]:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="8" r="4"></circle>
    <path d="M4 21a8 8 0 0 1 16 0"></path>
  </svg>
  <span class="hidden sm:inline group-data-[signed-in]:hidden">Sign up</span>
  <span class="hidden group-data-[signed-in]:inline" data-account-initial
  ></span>
</a>

<script>
  import { getProgressStore } from "@/lib/progress";

  const store = getProgressStore();

  function render() {
    const account = store.getAccount();
    for (const link of document.querySelectorAll<HTMLElement>(
      "[data-account]"
    )) {
      link.classList.toggle("hidden", !store.canSignIn);
      link.classList.toggle("inline-flex", store.canSignIn);
      link.toggleAttribute("data-signed-in", account !== null);
      const label = account ? "Your account" : "Sign up or sign in";
      link.setAttribute("aria-label", label);
      link.title = label;
      const initial = link.querySelector("[data-account-initial]");
      if (initial && account) {
        initial.textContent = (account.name || account.email)
          .charAt(0)
          .toUpperCase();
      }
    }
  }

  store.subscribe(render);
  render();
</script>
