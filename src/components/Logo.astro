---
/*
 * The open-book app icon, drawn with the primary tokens so it follows the
 * light and dark themes. Decorative: always sits next to the app name.
 */
type Props = {
  class?: string;
};

const { class: className = "size-7" } = Astro.props;
---

<svg
  class:list={["shrink-0", className]}
  viewBox="0 0 512 512"
  aria-hidden="true"
>
  <rect width="512" height="512" rx="112" class="fill-primary"></rect>
  <path
    d="M256 168c-46-28-104-36-164-30v236c60-6 118 2 164 30 46-28 104-36 164-30V138c-60-6-118 2-164 30Zm0 0v236"
    fill="none"
    class="stroke-primary-foreground"
    stroke-width="44"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
