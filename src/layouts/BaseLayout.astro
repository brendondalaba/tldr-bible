---
import AccountMenu from "@/components/AccountMenu.astro";
import Logo from "@/components/Logo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Toasts from "@/components/Toasts.astro";
import "@/styles/global.css";

type Props = {
  title: string;
  description?: string;
  /** The home page hero already has the title and Start Here link. */
  showNav?: boolean;
};

const { title, description = "", showNav = true } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover lets the page paint behind the phone's gesture bar. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <!-- Browser UI color; matches --surface in tokens.css. -->
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#15191e"
    />
    <meta name="apple-mobile-web-app-title" content="Bible Sidekick" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{title}</title>
    <!-- Runs before first paint so a saved theme never flashes the wrong colors. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
          // Same as applyThemeColor() in src/lib/themeColor.ts.
          const source = document.querySelector(
            `meta[name="theme-color"][media*="${theme}"]`
          );
          if (source) {
            const forced = document.createElement("meta");
            forced.name = "theme-color";
            forced.content = source.content;
            forced.dataset.forced = "";
            document.head.prepend(forced);
          }
        }
      } catch {}
    </script>
  </head>
  <body
    class="flex min-h-dvh flex-col pr-[env(safe-area-inset-right)] pl-[env(safe-area-inset-left)]"
  >
    {
      showNav && (
        <nav class="border-b bg-surface">
          <div
            class="mx-auto flex w-full max-w-5xl items-center justify-between gap-2 px-4 py-3 sm:gap-4 sm:px-6"
          >
            <a
              href="/"
              class="flex items-center gap-2 whitespace-nowrap font-semibold tracking-tight"
            >
              <Logo />
              Bible Sidekick
            </a>
            <div class="flex items-center gap-2 sm:gap-4">
              <a
                href="/start-here"
                class="whitespace-nowrap text-muted-foreground text-sm transition-colors duration-150 hover:text-foreground"
              >
                <span class="sm:hidden">Start here</span>
                <span class="hidden sm:inline">How to read the Bible</span>
              </a>
              <ThemeToggle />
              <AccountMenu />
            </div>
          </div>
        </nav>
      )
    }

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t bg-surface">
      <!-- Bottom padding keeps the footer color behind the phone's gesture bar. -->
      <div
        class="mx-auto w-full max-w-5xl px-4 pt-8 pb-[calc(2rem+env(safe-area-inset-bottom))] text-center text-muted-foreground text-sm sm:px-6"
      >
        Find Jesus ❤️
      </div>
    </footer>
    <Toasts />
  </body>
</html>
